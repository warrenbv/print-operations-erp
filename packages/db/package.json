{
  "name": "@erp/db",
  "version": "0.0.0",
  "private": true,
  "description": "Shared database plumbing: connection pools, per-module Drizzle handles, migrations and test databases.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "migrate": "pnpm run build && node dist/cli/migrate.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
