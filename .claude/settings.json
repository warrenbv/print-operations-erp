{
  "permissions": {
    "allow": [
      "Bash(glab issue list:*)",
      "Bash(glab issue view:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr list:*)",
      "Bash(glab auth status)"
    ],
    "ask": [
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(docs/charter/**)",
      "Write(docs/charter/**)",
      "Edit(docs/decisions/**)",
      "Write(docs/decisions/**)",
      "Edit(docs/requirements/**)",
      "Write(docs/requirements/**)",
      "Edit(docs/backlog/**)",
      "Write(docs/backlog/**)",
      "Edit(tools/project-plan/backlog.py)",
      "Write(tools/project-plan/backlog.py)",
      "Edit(pipeline.yml)",
      "Write(pipeline.yml)",
      "Edit(.forge/**)",
      "Write(.forge/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(scripts/ci/**)",
      "Write(scripts/ci/**)"
    ],
    "deny": ["Bash(glab mr merge:*)", "Read(.env)", "Read(**/.env)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/refuse-git-stash.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
