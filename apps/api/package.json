{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "ERP API application (NestJS). Thin composition layer over modules.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@erp/crm": "workspace:^",
    "@erp/db": "workspace:^",
    "@erp/documents": "workspace:^",
    "@erp/identity": "workspace:^",
    "@erp/notifications": "workspace:^",
    "@erp/orders": "workspace:^",
    "@erp/quoting": "workspace:^",
    "@erp/types": "workspace:*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "cookie-parser": "^1.4.7",
    "qs": "^6.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
