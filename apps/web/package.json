{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "description": "ERP web application (Next.js). The browser-facing shell + per-module UIs.",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@erp/types": "workspace:*",
    "@erp/ui": "workspace:*",
    "@erp/utils": "workspace:*",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
