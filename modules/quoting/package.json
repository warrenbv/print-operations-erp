{
  "name": "@erp/quoting",
  "version": "0.0.0",
  "private": true,
  "description": "Quote pricing and the quote lifecycle, with the grades, pricing configuration, tiers and tax rates they depend on.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@erp/db": "workspace:^",
    "@erp/types": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
